# Copy to backend/.env and fill in. Never commit the real .env.

# --- Core ---------------------------------------------------------------
DEBUG=false
# Long random string, e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"`
SECRET_KEY=
# Optional separate key for encrypting Google tokens at rest (falls back to SECRET_KEY)
ENCRYPTION_KEY=
DATABASE_URL=postgresql://postgres:password@localhost:5432/reviewsaas
REDIS_URL=redis://localhost:6379

# --- URLs ---------------------------------------------------------------
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
# Comma-separated
CORS_ORIGINS=http://localhost:3000
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/google/callback

# --- Admin --------------------------------------------------------------
# Comma-separated; admin endpoints are locked for everyone if empty
ADMIN_EMAILS=

# --- OpenAI -------------------------------------------------------------
OPENAI_API_KEY=

# --- Stripe -------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_STARTER_PRICE_ID=
STRIPE_PRO_PRICE_ID=

# --- SendGrid -----------------------------------------------------------
SENDGRID_API_KEY=
FROM_EMAIL=

# --- Google Business Profile OAuth ---------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Monitoring (optional) ----------------------------------------------
SENTRY_DSN=
